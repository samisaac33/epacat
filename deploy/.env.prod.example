# Copiar a .env.prod en la raíz del repo (junto a docker-compose.prod.yml)

# --- Postgres (solo red interna Docker) ---
POSTGRES_USER=epacat
POSTGRES_PASSWORD=cambiar_contraseña_fuerte
POSTGRES_DB=epacat_db

# --- API (leídas por el servicio api) ---
JWT_SECRET=cambiar_secreto_largo_compartido_con_vercel
JWT_EXPIRES_IN=7d

# Orígenes web + demo (separados por coma). Incluir dominio Vercel.
# Para pruebas amplias en demo: CORS_ORIGINS=*
CORS_ORIGINS=https://epim-web.vercel.app,http://localhost:3000

# URL pública HTTPS del API (fotos en validación / mapa)
API_PUBLIC_URL=https://api.su-dominio.gob.ec

# Puerto publicado en la VM (bind). Nginx/Caddy escucha 443 y proxy a 3001.
API_BIND=127.0.0.1:3001

# Mismo valor que en Vercel (web) si protegen rutas BFF con JWT
# JWT_SECRET ya arriba

BANCO_PACIFICO_API_KEY=demo-banco-pacifico-key
EPA_CUENTA_BANCO=0000000000

# Email: vacío = modo stub (adecuado para demo)
RESEND_API_KEY=
RESEND_FROM_EMAIL=demo@epim.local

RUN_MIGRATIONS_ON_START=true