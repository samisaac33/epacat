# Database
DATABASE_URL="postgresql://epacat:epacat_dev@localhost:5432/epacat_db?schema=public"

# API
API_PORT=3001
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,https://epim-web.vercel.app
STORAGE_PATH=./storage/uploads

# Banco Pacífico (recaudación)
BANCO_PACIFICO_API_KEY=dev-banco-pacifico-key
EPA_CUENTA_BANCO=0000-0000-0000

# Resend (correos de cobranza)
RESEND_API_KEY=
RESEND_FROM_EMAIL=cobranza@epim.gob.ec

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
# Mismo JWT_SECRET que la API: valida sesión en /api/comercial/* (snapshot sin CORS)
JWT_SECRET=change-me-in-production-use-long-random-string

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:3001
