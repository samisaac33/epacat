{
  "expo": {
    "name": "EPACAT",
    "slug": "epacat-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "epacat",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0369a1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ec.gob.epacat.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0369a1"
      },
      "package": "ec.gob.epacat.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EPACAT necesita tu ubicación para registrar visitas de campo."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "EPACAT necesita la cámara para fotografiar medidores."
        }
      ]
    ]
  }
}
