generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TECHNICIAN
  MANAGER
  ADMIN
}

enum SyncBatchStatus {
  PENDING
  PROCESSED
  FAILED
}

enum SyncOpType {
  CREATE
  UPDATE
}

enum SyncEntity {
  ABONADO
  MEDIDOR
  VISITA
  LECTURA
}

enum ValidationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VisitaStatus {
  DRAFT
  SYNCED
  VALIDATED
  REJECTED
}

enum FotoTipo {
  MEDIDOR
  FACHADA
  LECTURA
}

enum PeriodoStatus {
  ABIERTO
  CERRADO
}

enum FacturaStatus {
  EMITIDA
  PAGADA
  VENCIDA
  ANULADA
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  OTRO
  PACIFICO_VENTANILLA
  PACIFICO_BANCA_WEB
  PACIFICO_BANCA_MOVIL
}

enum PagoOrigen {
  MANUAL
  BANCO_PACIFICO
}

enum PagoCanal {
  VENTANILLA
  BANCA_WEB
  BANCA_MOVIL
  MANUAL
}

enum CobranzaEmailTipo {
  FACTURA_EMITIDA
  RECORDATORIO
  COMPROBANTE_PAGO
  VENCIMIENTO
}

enum CobranzaEmailStatus {
  SENT
  STUB
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  role         Role     @default(TECHNICIAN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  visitas          VisitaCampo[]
  batches          SyncBatch[]
  periodosCerrados PeriodoFacturacion[]
  pagosRegistrados Pago[]
}

model Abonado {
  id        String   @id @default(cuid())
  clientId  String   @unique
  cedula    String   @unique
  ruc       String?  @unique
  nombre    String
  direccion String
  sector    String
  telefono  String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medidores       Medidor[]
  visitas         VisitaCampo[]
  facturas        Factura[]
  cobranzaEmails  CobranzaEmail[]
}

model Medidor {
  id          String   @id @default(cuid())
  clientId    String   @unique
  numeroSerie String   @unique
  marca       String
  ubicacion   String?
  abonadoId   String
  abonado     Abonado  @relation(fields: [abonadoId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lecturas      Lectura[]
  visitas       VisitaCampo[]
  facturaLineas FacturaLinea[]
}

model VisitaCampo {
  id            String       @id @default(cuid())
  clientId      String       @unique
  lat           Float
  lng           Float
  observaciones String?
  status        VisitaStatus @default(DRAFT)
  tecnicoId     String
  tecnico       User         @relation(fields: [tecnicoId], references: [id])
  abonadoId     String?
  abonado       Abonado?     @relation(fields: [abonadoId], references: [id])
  medidorId     String?
  medidor       Medidor?     @relation(fields: [medidorId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  fotos      Foto[]
  lecturas   Lectura[]
  validacion Validacion?
}

model Lectura {
  id        String       @id @default(cuid())
  clientId  String       @unique
  valor     Float
  fecha     DateTime
  medidorId String
  medidor   Medidor      @relation(fields: [medidorId], references: [id])
  visitaId  String?
  visita    VisitaCampo? @relation(fields: [visitaId], references: [id])
  fotoId    String?
  foto      Foto?        @relation(fields: [fotoId], references: [id])
  createdAt DateTime     @default(now())

  facturaLineaActual   FacturaLinea?  @relation("LecturaActual")
  facturaLineaAnterior FacturaLinea[] @relation("LecturaAnterior")
}

model Foto {
  id           String      @id @default(cuid())
  localPhotoId String?     @unique
  path         String
  tipo         FotoTipo
  visitaId     String
  visita       VisitaCampo @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  lecturas     Lectura[]
  createdAt    DateTime    @default(now())
}

model SyncBatch {
  id            String          @id @default(cuid())
  clientBatchId String          @unique
  deviceId      String
  status        SyncBatchStatus @default(PENDING)
  resultJson    Json?
  tecnicoId     String
  tecnico       User            @relation(fields: [tecnicoId], references: [id])
  operations    SyncOperation[]
  createdAt     DateTime        @default(now())
  processedAt   DateTime?
}

model SyncOperation {
  id             String     @id @default(cuid())
  opId           String
  type           SyncOpType
  entity         SyncEntity
  clientEntityId String
  payload        Json
  batchId        String
  batch          SyncBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  success        Boolean    @default(false)
  errorMessage   String?
}

model Validacion {
  id         String           @id @default(cuid())
  status     ValidationStatus @default(PENDING)
  comentario String?
  visitaId   String           @unique
  visita     VisitaCampo      @relation(fields: [visitaId], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model Tarifa {
  id           String   @id @default(cuid())
  nombre       String
  cargoFijo    Float
  precioM3     Float
  vigenteDesde DateTime @default(now())
  activa       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PeriodoFacturacion {
  id           String        @id @default(cuid())
  anio         Int
  mes          Int
  status       PeriodoStatus @default(ABIERTO)
  fechaInicio  DateTime
  fechaFin     DateTime
  cerradoAt    DateTime?
  cerradoPorId String?
  cerradoPor   User?         @relation(fields: [cerradoPorId], references: [id])
  createdAt    DateTime      @default(now())

  facturas Factura[]

  @@unique([anio, mes])
}

model Factura {
  id               String             @id @default(cuid())
  numero           String             @unique
  abonadoId        String
  abonado          Abonado            @relation(fields: [abonadoId], references: [id])
  periodoId        String
  periodo          PeriodoFacturacion @relation(fields: [periodoId], references: [id])
  subtotal         Float
  cargoFijo        Float
  total            Float
  status           FacturaStatus      @default(EMITIDA)
  fechaEmision     DateTime           @default(now())
  fechaVencimiento DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  lineas         FacturaLinea[]
  pagos          Pago[]
  cobranzaEmails CobranzaEmail[]
}

model FacturaLinea {
  id                String   @id @default(cuid())
  facturaId         String
  factura           Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  medidorId         String
  medidor           Medidor  @relation(fields: [medidorId], references: [id])
  lecturaAnteriorId String?
  lecturaAnterior   Lectura? @relation("LecturaAnterior", fields: [lecturaAnteriorId], references: [id])
  lecturaActualId   String   @unique
  lecturaActual     Lectura  @relation("LecturaActual", fields: [lecturaActualId], references: [id])
  consumo           Float
  precioM3          Float
  monto             Float
}

model Pago {
  id                 String      @id @default(cuid())
  facturaId          String
  factura            Factura     @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  monto              Float
  metodo             MetodoPago
  origen             PagoOrigen  @default(MANUAL)
  canal              PagoCanal?
  transaccionBancoId String?     @unique
  referencia         String?
  revertido          Boolean     @default(false)
  fecha              DateTime    @default(now())
  registradoPorId    String?
  registradoPor      User?       @relation(fields: [registradoPorId], references: [id])
  createdAt          DateTime    @default(now())
}

model CobranzaEmail {
  id        String              @id @default(cuid())
  facturaId String?
  factura   Factura?            @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  abonadoId String
  abonado   Abonado             @relation(fields: [abonadoId], references: [id])
  tipo      CobranzaEmailTipo
  destino   String
  resendId  String?
  status    CobranzaEmailStatus
  error     String?
  createdAt DateTime            @default(now())
}
